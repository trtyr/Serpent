{
  "name": "serpent",
  "productName": "Serpent",
  "version": "0.3.3",
  "description": "An open-source digital asset manager for creative professionals.",
  "author": "dolag233",
  "license": "MIT",
  "private": true,
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node scripts/dev-start.mjs",
    "prestart": "node scripts/ensure-native.mjs && node scripts/patch-dev-electron-name.mjs",
    "start:forge": "electron-forge start",
    "start:multi": "node scripts/dev-start.mjs --multi",
    "prepackage": "node scripts/media-binaries.mjs ensure && node scripts/verify-ufbx-wasm.mjs",
    "package": "electron-forge package",
    "verify:package": "node scripts/verify-package.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "media:acquire": "node scripts/media-binaries.mjs acquire",
    "media:ensure": "node scripts/media-binaries.mjs ensure",
    "media:manifest": "node scripts/media-binaries.mjs manifest",
    "media:verify": "node scripts/media-binaries.mjs verify",
    "premake": "node scripts/media-binaries.mjs ensure && node scripts/verify-ufbx-wasm.mjs",
    "make": "electron-forge make",
    "make:appimage": "node scripts/make-appimage.mjs",
    "make:appimage:docker": "bash scripts/appimage-docker.sh",
    "make:inno": "node scripts/inno-build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest-with-electron.mjs run --exclude tests/worker/search-performance.test.ts",
    "pretest": "node scripts/ensure-native.mjs",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:worker": "node scripts/run-vitest-with-electron.mjs run --config vitest.config.ts tests/worker",
    "pretest:worker": "node scripts/ensure-native.mjs",
    "test:library-availability": "node scripts/run-vitest-with-electron.mjs run --config vitest.config.ts tests/worker/library-availability.test.ts tests/worker/library-schema-readonly.test.ts tests/worker/database-recovery.test.ts tests/worker/schema-failure.test.ts tests/worker/schema-compatibility.test.ts tests/worker/schema-downgrade-chain.test.ts tests/worker/schema-lenient-read.test.ts tests/worker/migration-discipline.test.ts tests/worker/library-service.test.ts",
    "pretest:library-availability": "node scripts/ensure-native.mjs",
    "test:perf:search": "node scripts/run-vitest-with-electron.mjs run --config vitest.config.ts tests/worker/search-performance.test.ts",
    "test:perf:media-tasks": "node scripts/run-media-task-performance.mjs",
    "test:perf:palette": "node scripts/run-palette-benchmark.mjs",
    "large-library:generate": "node scripts/generate-large-library.mjs",
    "test:perf:large-library": "node scripts/run-large-library-performance.mjs",
    "verify:mainline": "node scripts/verify-mainline.mjs",
    "release:verify": "node scripts/release/pipeline.mjs verify",
    "release:media": "node scripts/release/pipeline.mjs media",
    "release:package": "node scripts/release/pipeline.mjs package",
    "release:make": "node scripts/release/pipeline.mjs make",
    "release:checksums": "node scripts/release/pipeline.mjs checksums",
    "release:local": "node scripts/release/pipeline.mjs all",
    "test:watch": "node scripts/run-vitest-with-electron.mjs --config vitest.config.ts",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "ticket": "node scripts/ticket.mjs",
    "install:git-hooks": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.2.10",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@napi-rs/canvas": "^1.0.7",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "12.11.1",
    "chardet": "^2.2.0",
    "exifr": "^7.1.3",
    "harmonyos-sans-sc-webfont-splitted": "^1.1.0",
    "ignore": "7.0.6",
    "koffi": "^3.1.5",
    "libarchive-wasm": "^1.2.0",
    "pdfjs-dist": "^6.2.108",
    "quickjs-emscripten": "0.32.0",
    "sharp": "^0.35.3",
    "sqlite-vec": "0.1.9",
    "three": "^0.185.1",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/rebuild": "^3.7.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/three": "^0.185.4",
    "@types/yauzl": "3.4.0",
    "electron": "43.1.0",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "happy-dom": "^20.0.11",
    "to-ico": "^1.1.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
